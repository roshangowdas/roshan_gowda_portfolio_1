<svg xmlns="http://www.w3.org/2000/svg" width="1280" height="720" viewBox="0 0 1280 720">
  <!-- Background -->
  <rect width="1280" height="720" fill="#121212" />

  <!-- Top Navbar -->
  <rect width="1280" height="40" fill="#1a1a1a" />
  <circle cx="25" cy="20" r="6" fill="#ff5f56" />
  <circle cx="45" cy="20" r="6" fill="#ffbd2e" />
  <circle cx="65" cy="20" r="6" fill="#27c93f" />
  <text x="100" y="25" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="12" fill="#666666">npmjs.com/package/@roshan__gowda/react-status-kit</text>

  <!-- Main Content Container -->
  <g transform="translate(40, 60)">
    <!-- Title Section -->
    <text x="0" y="30" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="28" font-weight="bold" fill="#ffffff">@roshan__gowda/react-status-kit</text>
    <text x="0" y="58" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" fill="#888888">1.0.0  •  Public  •  Published 6 days ago</text>

    <!-- Navigation Tabs -->
    <g transform="translate(0, 95)">
      <!-- Readme Tab -->
      <text x="20" y="20" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="600" fill="#f1e05a">Readme</text>
      <line x1="0" y1="35" x2="180" y2="35" stroke="#f1e05a" stroke-width="2" />

      <!-- Code Tab -->
      <text x="220" y="20" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" fill="#e65353">Code</text>
      <rect x="260" y="5" width="40" height="20" rx="10" fill="#1b3a2b" stroke="#2ea043" stroke-width="1" />
      <text x="280" y="19" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="10" fill="#3fb950" text-anchor="middle">Beta</text>
      <line x1="180" y1="35" x2="340" y2="35" stroke="#e65353" stroke-width="2" />

      <!-- Dependencies -->
      <text x="380" y="20" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" fill="#a371f7">0 Dependencies</text>
      <line x1="340" y1="35" x2="510" y2="35" stroke="#a371f7" stroke-width="2" />

      <!-- Dependents -->
      <text x="540" y="20" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" fill="#a371f7">0 Dependents</text>
      <line x1="510" y1="35" x2="680" y2="35" stroke="#a371f7" stroke-width="2" />

      <!-- Versions Active Tab -->
      <rect x="680" y="-10" width="140" height="45" rx="4" fill="#162c2a" stroke="#267871" stroke-width="1.5" />
      <text x="750" y="18" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="bold" fill="#38d9a9" text-anchor="middle">1 Versions</text>

      <!-- Settings -->
      <text x="880" y="20" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" fill="#e65353">Settings</text>
      <line x1="820" y1="35" x2="1000" y2="35" stroke="#e65353" stroke-width="2" />
    </g>

    <!-- Main Content Area -->
    <g transform="translate(0, 160)">
      <!-- Left Section -->
      <!-- Current Tags -->
      <text x="0" y="20" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">Current Tags</text>
      <line x1="0" y1="40" x2="730" y2="40" stroke="#333333" stroke-width="1" />
      <text x="0" y="70" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600" fill="#aaaaaa">Version</text>
      <text x="350" y="70" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600" fill="#aaaaaa">Downloads (Last 7 Days)</text>
      <text x="700" y="70" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600" fill="#aaaaaa">Tag</text>
      <line x1="0" y1="90" x2="730" y2="90" stroke="#333333" stroke-width="1" />
      
      <text x="0" y="120" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" fill="#58a6ff" text-decoration="underline">1.0.0</text>
      <text x="420" y="120" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" fill="#ffffff">23</text>
      <text x="700" y="120" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" fill="#8b949e">latest</text>
      <line x1="0" y1="140" x2="730" y2="140" stroke="#333333" stroke-width="1" />

      <!-- Version History -->
      <text x="0" y="190" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="18" font-weight="bold" fill="#ffffff">Version History</text>
      <line x1="0" y1="210" x2="730" y2="210" stroke="#333333" stroke-width="1" />
      <text x="0" y="240" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600" fill="#aaaaaa">Version</text>
      <text x="350" y="240" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600" fill="#aaaaaa">Downloads (Last 7 Days)</text>
      <text x="650" y="240" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600" fill="#aaaaaa">Published</text>
      <line x1="0" y1="260" x2="730" y2="260" stroke="#333333" stroke-width="1" />

      <text x="0" y="290" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" fill="#58a6ff" text-decoration="underline">1.0.0</text>
      <text x="420" y="290" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" fill="#ffffff">23</text>
      <text x="650" y="290" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" fill="#8b949e">6 days ago</text>
      <line x1="0" y1="310" x2="730" y2="310" stroke="#333333" stroke-width="1" />
    </g>

    <!-- Right Sidebar Box -->
    <g transform="translate(790, 160)">
      <!-- Install Header -->
      <text x="0" y="20" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="bold" fill="#cccccc">Install</text>

      <!-- Command Box -->
      <rect x="0" y="35" width="370" height="60" rx="8" fill="#181818" stroke="#333333" stroke-width="1" />
      <text x="15" y="70" font-family="'Courier New', Courier, monospace" font-size="13" font-weight="bold" fill="#38d9a9">> npm i @roshan__gowda/react-status-kit</text>

      <!-- Downloads Chart Section -->
      <text x="0" y="130" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" font-weight="600" fill="#8b949e">Weekly Downloads</text>
      <text x="0" y="160" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="22" font-weight="bold" fill="#ffffff">21</text>
      <!-- Chart line -->
      <path d="M 0 180 L 220 180 L 360 150 L 360 180 Z" fill="#8a2be2" opacity="0.3" />
      <path d="M 0 180 L 220 180 L 360 150" stroke="#a855f7" stroke-width="3" fill="none" />
      <line x1="0" y1="185" x2="370" y2="185" stroke="#333333" stroke-width="1" />

      <!-- Details List -->
      <g transform="translate(0, 210)">
        <text x="0" y="0" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" fill="#8b949e">Version</text>
        <text x="0" y="22" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="16" font-weight="bold" fill="#ffffff">1.0.0</text>

        <text x="200" y="0" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" fill="#8b949e">License</text>
        <text x="200" y="22" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="16" font-weight="bold" fill="#ffffff">MIT</text>

        <line x1="0" y1="40" x2="370" y2="40" stroke="#262626" stroke-width="1" />

        <text x="0" y="65" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" fill="#8b949e">Last publish</text>
        <text x="0" y="87" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="16" font-weight="bold" fill="#ffffff">6 days ago</text>

        <line x1="0" y1="105" x2="370" y2="105" stroke="#262626" stroke-width="1" />

        <text x="0" y="130" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="13" fill="#8b949e">Collaborators</text>
        <circle cx="20" cy="160" r="16" fill="#10b981" />
        <text x="20" y="165" font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" font-size="14" font-weight="bold" fill="#000000" text-anchor="middle">R</text>
      </g>
    </g>
  </g>
</svg>
